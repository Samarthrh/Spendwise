# ========================================================
# SpendWise Production & Development Environment Variables
# ========================================================

# Server Port (Auto-assigned by Render/Railway, or defaults to 5001)
PORT=5001

# Environment: 'production' for live deployment, 'development' for local work
NODE_ENV=production

# Database Connection:
# For Local: mongodb://127.0.0.1:27017/spendwise
# For Production: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/spendwise?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/spendwise?retryWrites=true&w=majority

# JWT Authentication (In production, generate a secure random string: `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# OCR Engine: 'gemini' (Recommended - 99%+ accuracy) or 'tesseract' (offline)
OCR_PROVIDER=gemini

# Google Gemini API Key for OCR & Receipt Parsing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: CORS Allowed Origins (Comma-separated for multiple domains, or '*' for all)
# Example: ALLOWED_ORIGINS=https://spendwise.vercel.app,https://my-domain.com
ALLOWED_ORIGINS=*
